// 翻转的动作在使用者那边
// 视频定位：P04 04:32
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「原样」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

component MemoryTile inherits Rectangle {
    callback clicked;
    in property <bool> open_curtain;   // 由使用者设值
}

export component MainWindow inherits Window {
    MemoryTile {
        clicked => { self.open_curtain = !self.open_curtain; }
    }
}
