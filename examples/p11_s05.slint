// 百分号是单位
// 视频定位：P11 01:39
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「原样」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component Example {
    in-out property <length> w: 100px;
    in-out property <length> h: 50px;
    out property <float> ratio: self.w / self.h;
    out property <int> r: Math.mod(7, 4);  // 3
    // 50% 里的 % 是单位，不是取余
}
