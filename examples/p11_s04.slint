// 算术、比较、逻辑与三元
// 视频定位：P11 01:16
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「包进 Window」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component Example inherits Window {
    Rectangle {
        touch := TouchArea {}
        background: touch.pressed ? #111 : #eee;
        border-color: !touch.enabled ? #888
            : touch.pressed ? #aaa
            : #555;
    }
}
