// 不报错，也不告诉你
// 视频定位：P10 06:48
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「原样」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component Example {
    in-out property <[int]> items: [1, 2, 3];
    out property <int> len: items.length;  // 3
    out property <int> past: items[5];     // 0

    init => {
        items.remove(9);      // 越界：不做任何事
        items.insert(3, 10);  // 等于追加，合法
    }
}
