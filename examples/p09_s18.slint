// 让两个属性一体
// 视频定位：P09 05:57
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「原样」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component MyButton inherits Rectangle {
    in-out property <string> text <=> txt.text;
    callback clicked <=> touch.clicked;

    txt := Text { text: "默认文字"; }
    touch := TouchArea { }
}
