// px 之外还有百分比与 rem
// 视频定位：P03 03:06
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「包进 Window」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component Example inherits Window {
    Rectangle {
        width: 50%;           // 等于 parent.width / 2
        height: 40px;
        Text {
            font-size: 1.2rem; // 跟窗口默认字号联动
        }
    }
}
