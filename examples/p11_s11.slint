// 给元素起名字用的
// 视频定位：P11 03:41
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「原样」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component Example {
    in-out property <int> counter;
    TouchArea {
        clicked => {
            let step = 2;        // 局部变量不可变
            root.counter += step;
        }
    }
}
