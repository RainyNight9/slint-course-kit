// 对齐管哪一根轴
// 视频定位：P14 06:37
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「包进 Window」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component Example inherits Window {
    VerticalLayout {
        alignment: start;               // 主轴：上下
        cross-axis-alignment: center;   // 交叉轴：左右
        Text { text: "标题"; }
        Rectangle { width: 120px; height: 40px; }
    }
}
