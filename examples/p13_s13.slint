// 不是修改属性
// 视频定位：P13 04:23
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「原样」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component Light inherits Rectangle {
    in-out property <bool> on: false;
    background: self.on ? #333333 : #eeeeee;

    states [
        lit when self.on: {
            background: #34CE57;  // 激活期间接管
        }
    ]
}
