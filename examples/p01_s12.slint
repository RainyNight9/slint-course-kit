// 一段绑定，三个动态效果
// 视频定位：P01 04:37
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「包进 Window」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component Example inherits Window {
    ta := TouchArea {}

    myRect := Rectangle {
        x: ta.mouse-x;
        y: ta.mouse-y;
        width: 160px;
        height: 60px;
        background: ta.pressed ? orange : skyblue;
        Text {
            text: "x: " + (myRect.x / 1px);
        }
    }
}
