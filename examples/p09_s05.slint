// 分号与返回
// 视频定位：P09 01:43
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「原样」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component Example inherits Rectangle {
    width: 42px;              // 表达式 + 分号
    height: { 42px }          // 代码块，末值是返回值

    touch := TouchArea { }
    background: {
        if (touch.pressed) { return red; }
        return blue;
    }
}
