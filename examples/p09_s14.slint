// 视频定位：P09 04:36
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「原样」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component Button {
    in property <string> text;         // 使用者设文字
    out property <bool> pressed;       // 按钮报告按下
    in-out property <bool> checked;    // 两边都能改
    private property <bool> has-mouse; // 内部实现
}
