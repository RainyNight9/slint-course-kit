// alignment 与 stretch
// 视频定位：P14 06:00
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「包进 Window」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component Example inherits Window {
    HorizontalLayout {
        Rectangle { background: navy; horizontal-stretch: 2; }
        Rectangle { background: gray; }   // stretch 1
        // 空间分配比例 2 : 1
    }
}
