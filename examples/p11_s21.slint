// 点着用的数学函数
// 视频定位：P11 07:17
// 来源：Slint 官方中文课程逐镜脚本；核心片段逐字保留，仅为独立编译补了「原样」外壳。
// 校验：slint-interpreter 1.18.1 编译通过

export component Example {
    out property <float> d: (-10).abs();
    out property <int> n: 3.6.round();      // 4
    out property <length> s: (-10px).abs(); // 10px
}
// Math.abs(x) 与 abs(x) 与 x.abs() 等价
